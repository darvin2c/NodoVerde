  {
    "id": "fpub",
    "type": "function",
    "z": "tablab",
    "name": "guardar publicado",
    "func": "const parts = msg.topic.split('/');\nconst hw = parts[1], dev = parts[2];\nconst pub = flow.get('pub') || {};\npub[hw] = pub[hw] || {};\npub[hw][dev] = { v: msg.payload.v, ts: msg.payload.ts };\nflow.set('pub', pub);\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 220,
    "wires": [
      []
    ]
