  {
    "id": "fstatus",
    "type": "function",
    "z": "tablab",
    "name": "guardar status",
    "func": "const parts = msg.topic.split('/');\nconst hw = parts[1], dev = parts[2];\nconst st = flow.get('status') || {};\nst[hw] = st[hw] || {};\nst[hw][dev] = { state: msg.payload.state, ts: msg.payload.ts };\nflow.set('status', st);\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 160,
    "wires": [
      []
    ]
  },
  {
    "id": "mqread",
    "type": "mqtt in",
    "z": "tablab",
    "name": "readings dispositivo",
    "topic": "terra/+/+/+/reading",
    "qos": "0",
    "datatype": "json",
    "broker": "mbrk",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 220,
