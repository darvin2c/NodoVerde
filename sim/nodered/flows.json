  {
    "id": "fmerge",
    "type": "function",
    "z": "tablab",
    "name": "merge verdad+publicado",
    "func": "const world = msg.payload;\nconst pub = flow.get('pub') || {};\nconst status = flow.get('status') || {};\nmsg.payload = { world, pub, status };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 80,
