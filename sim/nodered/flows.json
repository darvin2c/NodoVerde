        "board"
      ]
    ]
  },
  {
    "id": "mqstatus",
    "type": "mqtt in",
    "z": "tablab",
    "name": "status dispositivo",
    "topic": "terra/+/+/status/status",
    "qos": "1",
    "datatype": "json",
    "broker": "mbrk",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 160,
