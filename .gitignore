# --- Secretos ---
.env
*.local
# generado por brain/setup.sh — contiene token real de hooks
brain/openclaw.json
# generado por brain/sync-experts.mjs desde crop_profiles (ADR-0028) — SOUL/skills re-renderizables, MEMORY.md es estado experiencial; cada workspace lleva su propio .git de OpenClaw
brain/workspaces/experto-*/
brain/openclaw.json.bak

# --- Dependencias ---
node_modules/
__pycache__/
*.pyc

# --- Estado y datos generados (reproducibles) ---
# estado persistido del sim + caché de clima
sim/data/
# snapshots pg_dump de scripts/backup.sh
backups/
# datos del bucket
minio/data/
homeassistant/config/

# --- Runtime / logs ---
*.log
.DS_Store

# --- Builds ---
dist/
dist-server/
# Estado runtime que OpenClaw escribe en los workspaces (bootstrap/sesiones)
brain/workspaces/*/openclaw-workspace-state.json
