  {
    "id": "board",
    "type": "ui-template",
    "z": "tablab",
    "group": "gmundo",
    "name": "board",
    "order": 1,
    "width": "12",
    "height": "13",
    "head": "",
    "storeOutMessages": false,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "format": "<template>\n  <div>\n    <v-alert v-if=\"!msg || !msg.payload || !msg.payload.world\" type=\"warning\" density=\"compact\">Esperando la física (:7751)…</v-alert>\n    <template v-else>\n      <div style=\"display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap\">\n        <v-chip color=\"green\" label>⏱ día {{ world.elapsedDays.toFixed(1) }}</v-chip>\n        <v-chip label>×{{ world.speed }}</v-chip>\n        <v-chip label>escenario: {{ world.scenario }}</v-chip>\n        <v-chip label>🌡 {{ world.weather.airTemp }}°C · HR {{ world.weather.humidity }}% · ET0 {{ world.weather.et0.toFixed(2) }} mm/h</v-chip>\n        <v-chip v-if=\"world.offline\" color=\"orange\" label>offline</v-chip>\n        <v-spacer></v-spacer>\n        <v-select v-model=\"crop\" :items=\"['lechuga','tomate']\" density=\"compact\" hide-details label=\"cultivo\" style=\"max-width:130px\"></v-select>\n        <v-btn size=\"small\" color=\"green\" @click=\"send({ payload: { action: 'add', crop: crop } })\">+ Enchufar nodo</v-btn>\n        <v-select v-model=\"escenario\" :items=\"['normal','ec_baja','sensor_muerto']\" density=\"compact\" hide-details label=\"escenario\" style=\"max-width:170px\"></v-select>\n        <v-btn size=\"small\" color=\"amber\" @click=\"send({ payload: { action: 'scenario', name: escenario } })\">Aplicar</v-btn>\n      </div>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:10px\">\n        <v-card v-for=\"n in world.nodes\" :key=\"n.hw_id\" density=\"compact\">\n          <v-card-title class=\"text-subtitle-2 d-flex align-center\" style=\"gap:6px\">\n            <code>{{ n.hw_id }}</code>\n            <v-chip size=\"x-small\" label>{{ n.crop }}</v-chip>\n            <v-chip v-for=\"f in n.deadDevices\" :key=\"f\" size=\"x-small\" color=\"red\" label>💀 {{ f }}</v-chip>\n            <v-spacer></v-spacer>\n            <v-chip size=\"x-small\" :color=\"isOnline(n) ? 'green' : 'red'\" label>{{ isOnline(n) ? 'online' : 'offline' }}</v-chip>\n          </v-card-title>\n          <v-card-text class=\"pa-2\">\n            <table style=\"width:100%;font-size:12px\">\n              <thead><tr style=\"opacity:.6\"><th align=\"left\">métrica</th><th align=\"right\">verdad</th><th align=\"right\">publicado</th><th align=\"right\">Δ</th></tr></thead>\n              <tbody>\n                <tr><td>EC (mS/cm)</td><td align=\"right\">{{ fmt(n.state.ec) }}</td><td align=\"right\">{{ fmtPub(n, 'ec-01') }}</td><td align=\"right\">{{ diff(n.state.ec, pubOf(n, 'ec-01')) }}</td></tr>\n                <tr><td>pH</td><td align=\"right\">{{ fmt(n.state.ph) }}</td><td align=\"right\">{{ fmtPub(n, 'ph-01') }}</td><td align=\"right\">{{ diff(n.state.ph, pubOf(n, 'ph-01')) }}</td></tr>\n                <tr><td>temp agua (°C)</td><td align=\"right\">{{ fmt(n.state.waterTemp, 1) }}</td><td align=\"right\">{{ fmtPub(n, 'temp-01', 1) }}</td><td align=\"right\">{{ diff(n.state.waterTemp, pubOf(n, 'temp-01'), 1) }}</td></tr>\n                <tr><td>nivel tanque (%)</td><td align=\"right\">{{ fmt(n.state.tankLevel, 0) }}</td><td align=\"right\">{{ fmtPub(n, 'level-01', 0) }}</td><td align=\"right\">{{ diff(n.state.tankLevel, pubOf(n, 'level-01'), 0) }}</td></tr>\n                <tr><td>bomba</td><td align=\"right\">{{ n.state.pumpOn ? 'ON' : 'OFF' }}</td><td align=\"right\">{{ pubOf(n, 'pump-recirc-01') ?? '—' }}</td><td align=\"right\"></td></tr>\n                <tr><td>válvula/dosif. (ms)</td><td align=\"right\" colspan=\"3\">v={{ n.state.valveTimer }} · A={{ n.state.doserATimer }} · B={{ n.state.doserBTimer }} · pH={{ n.state.doserPhTimer }}</td></tr>\n                <tr><td>objetivos {{ n.crop }}</td><td align=\"right\" colspan=\"3\">EC {{ n.cropTargets.ec[0] }}–{{ n.cropTargets.ec[1] }} · pH {{ n.cropTargets.ph[0] }}–{{ n.cropTargets.ph[1] }}<span v-if=\"n.disableAutoDose\"> · auto-dose OFF</span></td></tr>\n              </tbody>\n            </table>\n          </v-card-text>\n          <v-card-actions>\n            <v-btn size=\"x-small\" color=\"red\" variant=\"tonal\" @click=\"send({ payload: { action: 'remove', hw_id: n.hw_id } })\">Desenchufar</v-btn>\n          </v-card-actions>\n        </v-card>\n      </div>\n    </template>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return { crop: 'lechuga', escenario: 'normal', escenarioSynced: false };\n  },\n  watch: {\n    // sincroniza el selector con el escenario real del mundo (una vez)\n    'world.scenario'(v) {\n      if (v && !this.escenarioSynced) { this.escenario = v; this.escenarioSynced = true; }\n    },\n  },\n  computed: {\n    world() {\n      return (this.msg && this.msg.payload && this.msg.payload.world) || null;\n    },\n  },\n  methods: {\n    pubOf(n, dev) {\n      const p = this.msg && this.msg.payload && this.msg.payload.pub;\n      const r = p && p[n.hw_id] && p[n.hw_id][dev];\n      return r ? r.v : null;\n    },\n    fmt(x, d = 2) {\n      return typeof x === 'number' ? x.toFixed(d) : '—';\n    },\n    fmtPub(n, dev, d = 2) {\n      const v = this.pubOf(n, dev);\n      return typeof v === 'number' ? v.toFixed(d) : (v ?? '—');\n    },\n    diff(truth, pub, d = 2) {\n      if (typeof truth !== 'number' || typeof pub !== 'number') return '—';\n      const dv = pub - truth;\n      return (dv >= 0 ? '+' : '') + dv.toFixed(d);\n    },\n    isOnline(n) {\n      const s = this.msg && this.msg.payload && this.msg.payload.status;\n      const st = s && s[n.hw_id] && s[n.hw_id]['ec-01'];\n      return !!st && st.state === 'online';\n    },\n  },\n};\n</script>",
    "x": 740,
    "y": 80,
    "wires": [
      [
        "swact"
      ]
    ]
